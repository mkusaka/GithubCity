{
  "name": "github-city",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsrs --fast",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/valibot-validator": "^0.6.2",
    "file-saver": "^2.0.5",
    "hono": "^4.13.16",
    "postprocessing": "^6.39.6",
    "three": "^0.187.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/file-saver": "^2.0.7",
    "@types/three": "^0.187.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "sass": "^1.107.1",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "^4.157.0"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxlint --fix",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{scss,html,json,jsonc,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
